POST {{baseUrl}}/api/v1/provider/spaces/{{providerSpaceId}}/resubmit
Authorization: Bearer {{providerToken}}

> {%
    client.test("409 INVALID_SPACE_STATUS", () => {
        client.assert(response.status === 409, `실제 ${response.status}`);
    });
%}
