    client.test("409 INVALID_SPACE_STATUS", () => {
        client.assert(response.status === 409, `실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_SPACE_STATUS", `실제 ${response.body.error.code}`);
    });
%}

### 검수 대기 중 다시 검수 요청 → 409
