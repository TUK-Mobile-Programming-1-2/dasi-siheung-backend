  "plan": "이틀 동안 떡볶이를 판매합니다.",
  "headcount": 2,
  "startDate": "{{revDay1}}",
  "endDate": "{{revDay2}}"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("revApplicationId", response.body.data.id);
%}

### 준비: 승인 (예약 확정)
POST {{baseUrl}}/api/v1/provider/applications/{{revApplicationId}}/approve
Authorization: Bearer {{revProviderToken}}

> {%
    client.test("APPROVED", () => client.assert(response.body.data.status === "APPROVED", `실제 ${response.body.data.status}`));
%}

### 이용 전에는 후기를 쓸 수 없다
# 인증: USER (신청자)
# 기대값: 409 REVIEW_NOT_ALLOWED
POST {{baseUrl}}/api/v1/applications/{{revApplicationId}}/review
Authorization: Bearer {{revUserToken}}
Content-Type: application/json

{
  "rating": 5,
  "content": "아직 이용 전"
}

> {%
    client.test("409 REVIEW_NOT_ALLOWED", () => {
        client.assert(response.status === 409, `실제 ${response.status}`);
        client.assert(response.body.error.code === "REVIEW_NOT_ALLOWED", `실제 ${response.body.error.code}`);
    });
%}

### 평점 범위 밖
# 기대값: 400 INVALID_INPUT
POST {{baseUrl}}/api/v1/applications/{{revApplicationId}}/review
Authorization: Bearer {{revUserToken}}
Content-Type: application/json

{
  "rating": 6,
  "content": "평점 6"
}

> {%
    client.test("400 INVALID_INPUT", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_INPUT", `실제 ${response.body.error.code}`);
    });
%}

### 공간 후기 목록 (로그인 없이)
# 기대값: 200 OK, 새 공간이라 0건 / 상세의 reviewCount 0, ratingAverage 없음
GET {{baseUrl}}/api/v1/spaces/{{revSpaceId}}/reviews

> {%
    client.test("200 OK + 0건", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.totalElements === 0, `실제 ${response.body.data.totalElements}`);
    });
%}

### 공간 상세의 평점 필드
GET {{baseUrl}}/api/v1/spaces/{{revSpaceId}}

> {%
    client.test("후기 0 · 평균 없음", () => {
        client.assert(response.body.data.reviewCount === 0, `실제 ${response.body.data.reviewCount}`);
        client.assert(response.body.data.ratingAverage === null || response.body.data.ratingAverage === undefined, "평균");
    });
%}

### 내가 쓴 후기
GET {{baseUrl}}/api/v1/members/me/reviews
Authorization: Bearer {{revUserToken}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
%}

### 평점 높은 순 정렬 (후기 없는 공간은 맨 뒤)
GET {{baseUrl}}/api/v1/spaces?sort=RATING&size=50

> {%
    client.test("평점 내림차순", () => {
        const values = response.body.data.content.map(s => s.ratingAverage);
        let seenNull = false;
        for (let i = 0; i < values.length; i++) {
            if (values[i] === null || values[i] === undefined) { seenNull = true; continue; }
            client.assert(!seenNull, "후기 없는 공간 뒤에 평점 있는 공간이 나왔습니다");
            if (i > 0 && values[i - 1] !== null && values[i - 1] !== undefined) {
                client.assert(values[i - 1] >= values[i], "평점 순서");
            }
        }
    });
%}

### 받은 후기 (공간 제공자) — 답글을 기다리는 후기만
# 인증: PROVIDER
# 기대값: 200 OK, 목록 형식. (.http 에서는 이용 기간을 지난날로 옮길 수 없어 이 제공자의 후기는 0건)
# 시연 데이터 계정(provider1@demo.dasisiheung.com)으로 호출하면 답글 대기 후기 1건이 보인다.
GET {{baseUrl}}/api/v1/provider/reviews?replied=false
Authorization: Bearer {{revProviderToken}}

> {%
    client.test("200 OK + 목록", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(Array.isArray(response.body.data.content), "content");
        client.assert(response.body.data.totalElements === 0, `실제 ${response.body.data.totalElements}`);
    });
%}

### 받은 후기 — 특정 공간만
# 기대값: 200 OK
GET {{baseUrl}}/api/v1/provider/reviews?spaceId={{revSpaceId}}
Authorization: Bearer {{revProviderToken}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
%}

### 받은 후기 — 이용자는 볼 수 없다
# 기대값: 403
GET {{baseUrl}}/api/v1/provider/reviews
Authorization: Bearer {{revUserToken}}

> {%
    client.test("403", () => client.assert(response.status === 403, `실제 ${response.status}`));
%}
