# 공간 이용 신청 시나리오 — 신청 · 가격 협의 · 승인 · 거절 · 취소
# 준비 단계에서 공개 공간을 만든다. (관리자 계정: http-client.private.env.json)

### 준비: 공간 제공자 가입
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "http-app-provider-{{$timestamp}}-{{$randomInt}}@test.dasisiheung.com",
  "password": "password123",
  "name": "신청받는 제공자",
  "phone": "010-7777-8888",
  "role": "PROVIDER"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("appProviderEmail", response.body.data.email);
%}

### 준비: 공간 제공자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{appProviderEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
    client.global.set("appProviderToken", response.body.data.accessToken);
    const day = (offset) => new Date(Date.now() + 9 * 3600 * 1000 + offset * 86400 * 1000).toISOString().substring(0, 10);
    for (let i = 1; i <= 6; i++) {
        client.global.set(`appDay${i}`, day(i));
    }
%}

### 준비: 공간 등록 (정왕, 1일 5만원, 내일부터 5일)
POST {{baseUrl}}/api/v1/provider/spaces
Authorization: Bearer {{appProviderToken}}
Content-Type: application/json

{
  "title": "정왕 시장 골목 1층",
  "description": "전통시장 입구 바로 앞 상가입니다.",
  "address": "경기도 시흥시 정왕대로 233",
  "latitude": 37.3517,
  "longitude": 126.7428,
  "areaSqm": 28.5,
  "buildingUse": "NEIGHBORHOOD_1",
  "commercialTheme": "FOOD_ALLEY",
  "dailyPrice": 50000,
  "facilities": ["ELECTRICITY", "WATER"],
  "activityTypes": ["POPUP_STORE", "EXPERIENCE"],
  "availableDates": ["{{appDay1}}", "{{appDay2}}", "{{appDay3}}", "{{appDay4}}", "{{appDay5}}"]
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("appSpaceId", response.body.data.id);
%}

### 준비: 증빙 제출
POST {{baseUrl}}/api/v1/provider/spaces/{{appSpaceId}}/proofs
Authorization: Bearer {{appProviderToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="proofType"

LEASE_CONTRACT
--dasi-boundary
Content-Disposition: form-data; name="file"; filename="proof.pdf"
Content-Type: application/pdf

< ./fixtures/proof.pdf
--dasi-boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
%}

### 준비: 관리자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("200 OK + ADMIN", () => {
        client.assert(response.status === 200, `실제 ${response.status} — http-client.private.env.json 의 관리자 계정 확인`);
        client.assert(response.body.data.member.role === "ADMIN", `실제 ${response.body.data.member.role}`);
    });
    client.global.set("adminToken", response.body.data.accessToken);
%}

### 준비: 공개 승인
POST {{baseUrl}}/api/v1/admin/spaces/{{appSpaceId}}/reviews
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "decision": "APPROVE",
  "checklist": { "authorityVerified": true, "addressMatched": true, "buildingUnitMatched": true, "areaMatched": true, "usageMatched": true }
}

> {%
    client.test("200 OK + PUBLISHED", () => client.assert(response.body.data.space.status === "PUBLISHED", `실제 ${response.body.data.space.status}`));
%}

