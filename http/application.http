### 신청서 제출 (이용자 A, 1~2일차)
# 인증: USER
# 기대값: 201 Created, PENDING, 정가 합계 100000 (5만원 × 2일), 협의 NONE
POST {{baseUrl}}/api/v1/applications
Authorization: Bearer {{appUserAToken}}
Content-Type: application/json

{
  "spaceId": {{appSpaceId}},
  "activityType": "POPUP_STORE",
  "activityTitle": "수제 캔들 팝업 스토어",
  "plan": "이틀 동안 수제 캔들을 전시 · 판매합니다. 테이블 2개를 가져갑니다.",
  "headcount": 3,
  "startDate": "{{appDay1}}",
  "endDate": "{{appDay2}}"
}

> {%
    client.test("201 Created + 정가 합계", () => {
        const data = response.body.data;
        client.assert(response.status === 201, `실제 ${response.status}`);
        client.assert(data.status === "PENDING", `실제 ${data.status}`);
        client.assert(data.listTotalPrice === 100000 && data.totalPrice === 100000, `실제 ${data.listTotalPrice} / ${data.totalPrice}`);
        client.assert(data.negotiationStatus === "NONE", `실제 ${data.negotiationStatus}`);
        client.assert(data.days === 2, `실제 ${data.days}`);
    });
    client.global.set("appAId", response.body.data.id);
%}

### 같은 기간 중복 신청
# 기대값: 409 DUPLICATE_APPLICATION
POST {{baseUrl}}/api/v1/applications
Authorization: Bearer {{appUserAToken}}
Content-Type: application/json

{
  "spaceId": {{appSpaceId}},
  "activityType": "POPUP_STORE",
  "activityTitle": "수제 캔들 팝업 스토어",
  "plan": "중복 신청",
  "headcount": 3,
  "startDate": "{{appDay2}}",
  "endDate": "{{appDay2}}"
}

> {%
    client.test("409 DUPLICATE_APPLICATION", () => {
        client.assert(response.status === 409, `실제 ${response.status}`);
        client.assert(response.body.error.code === "DUPLICATE_APPLICATION", `실제 ${response.body.error.code}`);
    });
%}

