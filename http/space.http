# 공간 둘러보기 (이용자) — 상세 · 검색 · 지도
# 조회(GET)는 로그인 없이 호출한다. 준비 단계에서 공개 공간을 하나 만든다. (관리자 계정: http-client.private.env.json)

### 준비: 공간 제공자 가입
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "http-browse-provider-{{$timestamp}}-{{$randomInt}}@test.dasisiheung.com",
  "password": "password123",
  "name": "둘러보기 제공자",
  "phone": "010-5555-6666",
  "role": "PROVIDER"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("browseProviderEmail", response.body.data.email);
    client.global.set("browseProviderId", response.body.data.id);
%}

### 준비: 공간 제공자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{browseProviderEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
    client.global.set("browseProviderToken", response.body.data.accessToken);
    const day = (offset) => new Date(Date.now() + 9 * 3600 * 1000 + offset * 86400 * 1000).toISOString().substring(0, 10);
    client.global.set("browseDay1", day(1));
    client.global.set("browseDay2", day(2));
    client.global.set("browseDay3", day(3));
%}

### 준비: 공간 등록 (거북섬, 내일~모레~글피)
POST {{baseUrl}}/api/v1/provider/spaces
Authorization: Bearer {{browseProviderToken}}
Content-Type: application/json

{
  "title": "거북섬 마리나 앞 전시 공간",
  "description": "바다가 보이는 통유리 1층 공간입니다.",
  "rules": "음식물 반입 금지",
  "address": "경기도 시흥시 거북섬중앙로 2",
  "buildingName": "마리나타워",
  "unitNumber": "102호",
  "latitude": 37.3175,
  "longitude": 126.6822,
  "areaSqm": 52.5,
  "buildingUse": "NEIGHBORHOOD_2",
  "commercialTheme": "WATERFRONT",
  "dailyPrice": 70000,
  "facilities": ["WIFI", "ELECTRICITY", "AIR_CONDITIONER"],
  "activityTypes": ["EXHIBITION", "POPUP_STORE"],
  "availableDates": ["{{browseDay1}}", "{{browseDay2}}", "{{browseDay3}}"]
}

> {%
    client.test("201 Created + GEOBUKSEOM", () => {
        client.assert(response.status === 201, `실제 ${response.status}`);
        client.assert(response.body.data.region === "GEOBUKSEOM", `실제 ${response.body.data.region}`);
    });
    client.global.set("browseSpaceId", response.body.data.id);
%}

### 공개 전(검수 대기)에는 이용자에게 보이지 않는다
# 기대값: 404 SPACE_NOT_FOUND
GET {{baseUrl}}/api/v1/spaces/{{browseSpaceId}}

> {%
    client.test("404 SPACE_NOT_FOUND", () => {
        client.assert(response.status === 404, `실제 ${response.status}`);
        client.assert(response.body.error.code === "SPACE_NOT_FOUND", `실제 ${response.body.error.code}`);
    });
%}

### 준비: 증빙 제출
POST {{baseUrl}}/api/v1/provider/spaces/{{browseSpaceId}}/proofs
Authorization: Bearer {{browseProviderToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="proofType"

LEASE_CONTRACT
--dasi-boundary
Content-Disposition: form-data; name="file"; filename="proof.pdf"
Content-Type: application/pdf

< ./fixtures/proof.pdf
--dasi-boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
%}

### 준비: 사진 1장
POST {{baseUrl}}/api/v1/provider/spaces/{{browseSpaceId}}/photos
Authorization: Bearer {{browseProviderToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="files"; filename="space-photo.jpg"
Content-Type: image/jpeg

< ./fixtures/space-photo.jpg
--dasi-boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
%}

### 준비: 관리자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("200 OK + ADMIN", () => {
        client.assert(response.status === 200, `실제 ${response.status} — http-client.private.env.json 의 관리자 계정 확인`);
        client.assert(response.body.data.member.role === "ADMIN", `실제 ${response.body.data.member.role}`);
    });
    client.global.set("adminToken", response.body.data.accessToken);
%}

### 준비: 공개 승인
POST {{baseUrl}}/api/v1/admin/spaces/{{browseSpaceId}}/reviews
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "decision": "APPROVE",
  "checklist": { "authorityVerified": true, "addressMatched": true, "buildingUnitMatched": true, "areaMatched": true, "usageMatched": true }
}

> {%
    client.test("200 OK + PUBLISHED", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.space.status === "PUBLISHED", `실제 ${response.body.data.space.status}`);
    });
%}

### 공간 상세 (로그인 없이)
# 인증: 없음
# 기대값: 200 OK, 사용 가능 날짜 3개(오름차순), 사진 1장, 제공자 이름, 증빙·검수 사유는 없음
GET {{baseUrl}}/api/v1/spaces/{{browseSpaceId}}

> {%
    client.test("200 OK + 이용자용 상세", () => {
        const data = response.body.data;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(data.availableDates.length === 3, `실제 ${data.availableDates}`);
        client.assert(data.availableDates[0] === client.global.get("browseDay1"), `실제 ${data.availableDates[0]}`);
        client.assert(data.photos.length === 1, `사진 ${data.photos.length}`);
        client.assert(data.provider.name === "둘러보기 제공자", `실제 ${data.provider.name}`);
        client.assert(data.proofs === undefined && data.reviewComment === undefined, "검수 정보가 노출되면 안 됩니다");
    });
%}

### 없는 공간
# 기대값: 404 SPACE_NOT_FOUND
GET {{baseUrl}}/api/v1/spaces/999999999

> {%
    client.test("404 SPACE_NOT_FOUND", () => {
        client.assert(response.status === 404, `실제 ${response.status}`);
        client.assert(response.body.error.code === "SPACE_NOT_FOUND", `실제 ${response.body.error.code}`);
    });
%}
