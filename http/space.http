# 공간 둘러보기 (이용자) — 상세 · 검색 · 지도
# 조회(GET)는 로그인 없이 호출한다. 준비 단계에서 공개 공간을 하나 만든다. (관리자 계정: http-client.private.env.json)

### 준비: 공간 제공자 가입
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "http-browse-provider-{{$timestamp}}-{{$randomInt}}@test.dasisiheung.com",
  "password": "password123",
  "name": "둘러보기 제공자",
  "phone": "010-5555-6666",
  "role": "PROVIDER"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("browseProviderEmail", response.body.data.email);
    client.global.set("browseProviderId", response.body.data.id);
%}

### 준비: 공간 제공자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{browseProviderEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
    client.global.set("browseProviderToken", response.body.data.accessToken);
    const day = (offset) => new Date(Date.now() + 9 * 3600 * 1000 + offset * 86400 * 1000).toISOString().substring(0, 10);
    client.global.set("browseDay1", day(1));
    client.global.set("browseDay2", day(2));
    client.global.set("browseDay3", day(3));
%}

### 준비: 공간 등록 (거북섬, 내일~모레~글피)
POST {{baseUrl}}/api/v1/provider/spaces
Authorization: Bearer {{browseProviderToken}}
Content-Type: application/json

{
  "title": "거북섬 마리나 앞 전시 공간",
  "description": "바다가 보이는 통유리 1층 공간입니다.",
  "rules": "음식물 반입 금지",
  "address": "경기도 시흥시 거북섬중앙로 2",
  "buildingName": "마리나타워",
  "unitNumber": "102호",
  "latitude": 37.3175,
  "longitude": 126.6822,
  "areaSqm": 52.5,
  "buildingUse": "NEIGHBORHOOD_2",
  "commercialTheme": "WATERFRONT",
  "dailyPrice": 70000,
  "facilities": ["WIFI", "ELECTRICITY", "AIR_CONDITIONER"],
  "activityTypes": ["EXHIBITION", "POPUP_STORE"],
  "availableDates": ["{{browseDay1}}", "{{browseDay2}}", "{{browseDay3}}"],
  "maxCapacity": 20,
  "equipment": [
    { "name": "작품 거치대", "quantity": 6 },
    { "name": "스탠드 조명", "quantity": 3 }
  ],
  "priceNegotiable": true
}

> {%
    client.test("201 Created + GEOBUKSEOM", () => {
        client.assert(response.status === 201, `실제 ${response.status}`);
        client.assert(response.body.data.region === "GEOBUKSEOM", `실제 ${response.body.data.region}`);
    });
    client.global.set("browseSpaceId", response.body.data.id);
%}

### 공개 전(검수 대기)에는 이용자에게 보이지 않는다
# 기대값: 404 SPACE_NOT_FOUND
GET {{baseUrl}}/api/v1/spaces/{{browseSpaceId}}

> {%
    client.test("404 SPACE_NOT_FOUND", () => {
        client.assert(response.status === 404, `실제 ${response.status}`);
        client.assert(response.body.error.code === "SPACE_NOT_FOUND", `실제 ${response.body.error.code}`);
    });
%}

### 준비: 증빙 제출
POST {{baseUrl}}/api/v1/provider/spaces/{{browseSpaceId}}/proofs
Authorization: Bearer {{browseProviderToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="proofType"

LEASE_CONTRACT
--dasi-boundary
Content-Disposition: form-data; name="file"; filename="proof.pdf"
Content-Type: application/pdf

< ./fixtures/proof.pdf
--dasi-boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
%}

### 준비: 사진 1장
POST {{baseUrl}}/api/v1/provider/spaces/{{browseSpaceId}}/photos
Authorization: Bearer {{browseProviderToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="files"; filename="space-photo.jpg"
Content-Type: image/jpeg

< ./fixtures/space-photo.jpg
--dasi-boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
%}

### 준비: 관리자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("200 OK + ADMIN", () => {
        client.assert(response.status === 200, `실제 ${response.status} — http-client.private.env.json 의 관리자 계정 확인`);
        client.assert(response.body.data.member.role === "ADMIN", `실제 ${response.body.data.member.role}`);
    });
    client.global.set("adminToken", response.body.data.accessToken);
%}

### 준비: 공개 승인
POST {{baseUrl}}/api/v1/admin/spaces/{{browseSpaceId}}/reviews
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "decision": "APPROVE",
  "checklist": { "authorityVerified": true, "addressMatched": true, "buildingUnitMatched": true, "areaMatched": true, "usageMatched": true }
}

> {%
    client.test("200 OK + PUBLISHED", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.space.status === "PUBLISHED", `실제 ${response.body.data.space.status}`);
    });
%}

### 공간 상세 (로그인 없이)
# 인증: 없음
# 기대값: 200 OK, 사용 가능 날짜 3개(오름차순), 사진 1장, 제공자 이름, 수용 인원 · 비품 · 협의 여부, 증빙·검수 사유는 없음
GET {{baseUrl}}/api/v1/spaces/{{browseSpaceId}}

> {%
    client.test("200 OK + 이용자용 상세", () => {
        const data = response.body.data;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(data.availableDates.length === 3, `실제 ${data.availableDates}`);
        client.assert(data.availableDates[0] === client.global.get("browseDay1"), `실제 ${data.availableDates[0]}`);
        client.assert(data.photos.length === 1, `사진 ${data.photos.length}`);
        client.assert(data.provider.name === "둘러보기 제공자", `실제 ${data.provider.name}`);
        client.assert(data.proofs === undefined && data.reviewComment === undefined, "검수 정보가 노출되면 안 됩니다");
    });
    client.test("수용 인원 · 비품 · 협의 여부", () => {
        const data = response.body.data;
        client.assert(data.maxCapacity === 20, `실제 ${data.maxCapacity}`);
        client.assert(data.equipment.map(e => `${e.name}:${e.quantity}`).join() === "작품 거치대:6,스탠드 조명:3",
            JSON.stringify(data.equipment));
        client.assert(data.priceNegotiable === true, `실제 ${data.priceNegotiable}`);
    });
%}

### 없는 공간
# 기대값: 404 SPACE_NOT_FOUND
GET {{baseUrl}}/api/v1/spaces/999999999

> {%
    client.test("404 SPACE_NOT_FOUND", () => {
        client.assert(response.status === 404, `실제 ${response.status}`);
        client.assert(response.body.error.code === "SPACE_NOT_FOUND", `실제 ${response.body.error.code}`);
    });
%}

### 공간 검색 — 조건 없이 (로그인 없이)
# 기대값: 200 OK, 페이지 응답, 방금 공개한 공간 포함 (최근 공개 순)
GET {{baseUrl}}/api/v1/spaces?size=100

> {%
    client.test("200 OK + 공개 공간 목록", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        const ids = response.body.data.content.map(s => String(s.id));
        client.assert(ids.includes(String(client.global.get("browseSpaceId"))), "방금 공개한 공간이 없습니다");
    });
%}

### 공간 검색 — 거북섬 · 전시 · 브랜드 홍보 · 내일~모레 · 예산 8만원 · 와이파이+냉방
# 기대값: 200 OK, 결과는 모두 GEOBUKSEOM 이고 7만원 공간이 들어 있다
GET {{baseUrl}}/api/v1/spaces?region=GEOBUKSEOM&activityType=EXHIBITION&purpose=PROMOTION&startDate={{browseDay1}}&endDate={{browseDay2}}&maxPrice=80000&facilities=WIFI&facilities=AIR_CONDITIONER&sort=PRICE_ASC&size=100

> {%
    client.test("200 OK + 조건 일치", () => {
        const content = response.body.data.content;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(content.every(s => s.region === "GEOBUKSEOM" && s.dailyPrice <= 80000), "조건에 맞지 않는 공간이 섞였습니다");
        client.assert(content.some(s => String(s.id) === String(client.global.get("browseSpaceId"))), "준비한 공간이 없습니다");
        for (let i = 1; i < content.length; i++) {
            client.assert(content[i - 1].dailyPrice <= content[i].dailyPrice, "낮은 가격 순이 아닙니다");
        }
    });
%}

### 공간 검색 — 운영 인원 20명 · 가격 협의 가능
# 기대값: 200 OK, 준비한 공간(수용 20명 · 협의 가능) 포함, 결과는 모두 수용 20명 이상 · 협의 가능
GET {{baseUrl}}/api/v1/spaces?region=GEOBUKSEOM&headcount=20&negotiableOnly=true&size=100

> {%
    client.test("200 OK + 포함", () => {
        const content = response.body.data.content;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(content.some(s => String(s.id) === String(client.global.get("browseSpaceId"))), "준비한 공간이 없습니다");
        client.assert(content.every(s => s.maxCapacity >= 20 && s.priceNegotiable === true), "조건에 맞지 않는 공간이 섞였습니다");
    });
%}

### 공간 검색 — 수용 인원보다 많으면 빠진다
# 기대값: 200 OK, 준비한 공간(수용 20명)은 없음
GET {{baseUrl}}/api/v1/spaces?region=GEOBUKSEOM&headcount=21&size=100

> {%
    client.test("200 OK + 제외", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        const ids = response.body.data.content.map(s => String(s.id));
        client.assert(!ids.includes(String(client.global.get("browseSpaceId"))), "수용 인원을 넘는 공간이 나왔습니다");
    });
%}

### 공간 검색 — 예산보다 비싸면 빠진다
# 기대값: 200 OK, 준비한 7만원 공간은 없음
GET {{baseUrl}}/api/v1/spaces?region=GEOBUKSEOM&maxPrice=69999&size=100

> {%
    client.test("200 OK + 제외", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        const ids = response.body.data.content.map(s => String(s.id));
        client.assert(!ids.includes(String(client.global.get("browseSpaceId"))), "예산을 넘는 공간이 나왔습니다");
    });
%}

### 공간 검색 — 지난 기간
# 기대값: 400 INVALID_SEARCH_PERIOD
GET {{baseUrl}}/api/v1/spaces?startDate=2020-01-01&endDate=2020-01-02

> {%
    client.test("400 INVALID_SEARCH_PERIOD", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_SEARCH_PERIOD", `실제 ${response.body.error.code}`);
    });
%}

### 공간 검색 — 종료일 없이 시작일만
# 기대값: 400 INVALID_INPUT (fieldErrors[0].field = periodValid)
GET {{baseUrl}}/api/v1/spaces?startDate={{browseDay1}}

> {%
    client.test("400 INVALID_INPUT", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_INPUT", `실제 ${response.body.error.code}`);
    });
%}

### 지도 마커 — 거북섬 일대 화면
# 기대값: 200 OK, 준비한 공간 마커 포함, 모든 마커가 화면 영역 안
GET {{baseUrl}}/api/v1/spaces/map?swLat=37.300&swLng=126.650&neLat=37.330&neLng=126.700

> {%
    client.test("200 OK + 영역 안 마커", () => {
        const markers = response.body.data.markers;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(markers.some(m => String(m.id) === String(client.global.get("browseSpaceId"))), "준비한 공간이 없습니다");
        client.assert(markers.every(m => m.latitude >= 37.300 && m.latitude <= 37.330 && m.longitude >= 126.650 && m.longitude <= 126.700),
            "영역 밖 마커가 섞였습니다");
        client.assert(markers.length <= 300, `마커 ${markers.length}`);
        client.assert(typeof response.body.data.truncated === "boolean", "truncated 누락");
    });
%}

### 지도 마커 — 허용하지 않는 활동으로 거르기
# 기대값: 200 OK, 준비한 공간(전시 · 팝업만 허용)은 CLASS 조건에서 빠진다
GET {{baseUrl}}/api/v1/spaces/map?swLat=37.300&swLng=126.650&neLat=37.330&neLng=126.700&activityType=CLASS

> {%
    client.test("200 OK + 제외", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        const ids = response.body.data.markers.map(m => String(m.id));
        client.assert(!ids.includes(String(client.global.get("browseSpaceId"))), "허용하지 않는 활동의 공간이 나왔습니다");
    });
%}

### 지도 마커 — 꼭짓점이 뒤바뀜
# 기대값: 400 INVALID_INPUT
GET {{baseUrl}}/api/v1/spaces/map?swLat=37.330&swLng=126.650&neLat=37.300&neLng=126.700

> {%
    client.test("400 INVALID_INPUT", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_INPUT", `실제 ${response.body.error.code}`);
    });
%}

### 공간 추천 — 브랜드 홍보 · 전시 · 내일~모레
# 인증: 없음
# 기대값: 200 OK, 점수 내림차순, 준비한 거북섬(수변 관광지) 공간이 이유 "브랜드 홍보에 맞는 상권 (수변 관광지)" 와 함께 포함
GET {{baseUrl}}/api/v1/spaces/recommendations?purpose=PROMOTION&activityType=EXHIBITION&startDate={{browseDay1}}&endDate={{browseDay2}}&limit=20

> {%
    client.test("200 OK + 점수 순", () => {
        const data = response.body.data;
        client.assert(response.status === 200, `실제 ${response.status}`);
        for (let i = 1; i < data.length; i++) {
            client.assert(data[i - 1].score >= data[i].score, "점수 내림차순이 아닙니다");
        }
        const mine = data.find(r => String(r.space.id) === String(client.global.get("browseSpaceId")));
        client.assert(mine, "준비한 공간이 없습니다");
        client.assert(mine.reasons.includes("브랜드 홍보에 맞는 상권 (수변 관광지)"), JSON.stringify(mine.reasons));
    });
%}

### 관리자: 상권 테마 보정 (수변 관광지 → 카페거리)
# 인증: ADMIN
# 기대값: 200 OK, 테마만 바뀌고 공개 상태 유지
PUT {{baseUrl}}/api/v1/admin/spaces/{{browseSpaceId}}/theme
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "commercialTheme": "CAFE_STREET"
}

> {%
    client.test("테마 보정 + PUBLISHED 유지", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.space.commercialTheme === "CAFE_STREET", `실제 ${response.body.data.space.commercialTheme}`);
        client.assert(response.body.data.space.status === "PUBLISHED", `실제 ${response.body.data.space.status}`);
    });
%}
