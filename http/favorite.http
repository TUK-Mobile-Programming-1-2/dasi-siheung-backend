# 공간 찜 — 찜하기 · 해제 · 내 찜 목록 · 상세의 찜 여부
# 준비 단계에서 공개 공간과 이용자를 만든다. (관리자 계정: http-client.private.env.json)

### 준비: 공간 제공자 가입
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "http-fav-provider-{{$timestamp}}-{{$randomInt}}@test.dasisiheung.com",
  "password": "password123",
  "name": "fav 제공자",
  "phone": "010-2000-0001",
  "role": "PROVIDER"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("favProviderEmail", response.body.data.email);
%}

### 준비: 공간 제공자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{favProviderEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
    client.global.set("favProviderToken", response.body.data.accessToken);
    const day = (offset) => new Date(Date.now() + 9 * 3600 * 1000 + offset * 86400 * 1000).toISOString().substring(0, 10);
    for (let i = 1; i <= 3; i++) {
        client.global.set(`favDay${i}`, day(i));
    }
%}

### 준비: 공간 등록
POST {{baseUrl}}/api/v1/provider/spaces
Authorization: Bearer {{favProviderToken}}
Content-Type: application/json

{
  "title": "배곧 공원 앞 쇼룸",
  "description": "배곧 공원 앞 쇼룸 — 시나리오용 공간",
  "address": "경기도 시흥시 시나리오로 1",
  "latitude": 37.3773,
  "longitude": 126.7302,
  "areaSqm": 30.0,
  "buildingUse": "NEIGHBORHOOD_1",
  "commercialTheme": "RESIDENTIAL",
  "dailyPrice": 30000,
  "facilities": ["WIFI"],
  "activityTypes": ["POPUP_STORE"],
  "availableDates": ["{{favDay1}}", "{{favDay2}}", "{{favDay3}}"]
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("favSpaceId", response.body.data.id);
%}

### 준비: 증빙 제출
POST {{baseUrl}}/api/v1/provider/spaces/{{favSpaceId}}/proofs
Authorization: Bearer {{favProviderToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="proofType"

LEASE_CONTRACT
--dasi-boundary
Content-Disposition: form-data; name="file"; filename="proof.pdf"
Content-Type: application/pdf

< ./fixtures/proof.pdf
--dasi-boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
%}

### 준비: 관리자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("200 OK + ADMIN", () => {
        client.assert(response.status === 200, `실제 ${response.status} — http-client.private.env.json 의 관리자 계정 확인`);
        client.assert(response.body.data.member.role === "ADMIN", `실제 ${response.body.data.member.role}`);
    });
    client.global.set("adminToken", response.body.data.accessToken);
%}

### 준비: 공개 승인
POST {{baseUrl}}/api/v1/admin/spaces/{{favSpaceId}}/reviews
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "decision": "APPROVE",
  "checklist": { "authorityVerified": true, "addressMatched": true, "buildingUnitMatched": true, "areaMatched": true, "usageMatched": true }
}

> {%
    client.test("PUBLISHED", () => client.assert(response.body.data.space.status === "PUBLISHED", `실제 ${response.body.data.space.status}`));
%}

### 준비: 이용자 가입
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "http-fav-user-{{$timestamp}}-{{$randomInt}}@test.dasisiheung.com",
  "password": "password123",
  "name": "찜하는 이용자",
  "phone": "010-2000-0002",
  "role": "USER"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("favUserEmail", response.body.data.email);
%}

### 준비: 이용자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{favUserEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
    client.global.set("favUserToken", response.body.data.accessToken);
%}

### 찜하기
# 인증: USER
# 기대값: 200 OK, favorited = true, favoriteCount = 1
PUT {{baseUrl}}/api/v1/spaces/{{favSpaceId}}/favorite
Authorization: Bearer {{favUserToken}}

> {%
    client.test("200 OK + 1", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.favorited === true && response.body.data.favoriteCount === 1, JSON.stringify(response.body.data));
    });
%}

### 한 번 더 찜하기 (멱등)
# 기대값: 200 OK, favoriteCount 그대로 1
PUT {{baseUrl}}/api/v1/spaces/{{favSpaceId}}/favorite
Authorization: Bearer {{favUserToken}}

> {%
    client.test("200 OK + 그대로 1", () => client.assert(response.body.data.favoriteCount === 1, `실제 ${response.body.data.favoriteCount}`));
%}

### 상세: 토큰을 보내면 favorited = true
GET {{baseUrl}}/api/v1/spaces/{{favSpaceId}}
Authorization: Bearer {{favUserToken}}

> {%
    client.test("favorited", () => {
        client.assert(response.body.data.favorited === true, "찜 여부");
        client.assert(response.body.data.favoriteCount === 1, `실제 ${response.body.data.favoriteCount}`);
    });
%}

### 상세: 비로그인이면 favorited = false
GET {{baseUrl}}/api/v1/spaces/{{favSpaceId}}

> {%
    client.test("비로그인", () => client.assert(response.body.data.favorited === false, "찜 여부"));
%}

### 내 찜 목록
# 기대값: 200 OK, 1건
GET {{baseUrl}}/api/v1/members/me/favorites
Authorization: Bearer {{favUserToken}}

> {%
    client.test("200 OK + 1건", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.totalElements === 1, `실제 ${response.body.data.totalElements}`);
        client.assert(String(response.body.data.content[0].id) === String(client.global.get("favSpaceId")), "공간 ID");
    });
%}

### 찜 많은 순 정렬 (선택지 spaceSorts 의 POPULAR)
GET {{baseUrl}}/api/v1/spaces?sort=POPULAR&size=20

> {%
    client.test("찜 수 내림차순", () => {
        const content = response.body.data.content;
        for (let i = 1; i < content.length; i++) {
            client.assert(content[i - 1].favoriteCount >= content[i].favoriteCount, "인기순이 아닙니다");
        }
    });
%}

### 공간 제공자는 찜할 수 없다
# 기대값: 403 FORBIDDEN
PUT {{baseUrl}}/api/v1/spaces/{{favSpaceId}}/favorite
Authorization: Bearer {{favProviderToken}}

> {%
    client.test("403", () => client.assert(response.status === 403, `실제 ${response.status}`));
%}

### 찜 해제 (두 번 보내도 성공)
DELETE {{baseUrl}}/api/v1/spaces/{{favSpaceId}}/favorite
Authorization: Bearer {{favUserToken}}

> {%
    client.test("200 OK + 0", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.favorited === false && response.body.data.favoriteCount === 0, JSON.stringify(response.body.data));
    });
%}

###
DELETE {{baseUrl}}/api/v1/spaces/{{favSpaceId}}/favorite
Authorization: Bearer {{favUserToken}}

> {%
    client.test("200 OK + 그대로 0", () => client.assert(response.body.data.favoriteCount === 0, `실제 ${response.body.data.favoriteCount}`));
%}
