# 역제안 알림 시나리오 — 제공자 역제안 → 창작자 알림함(푸시와 같은 내용) → 읽음 → 거절 · 재제안 · 수락
# Android #91 완료 확인 흐름과 같다. 신청은 끝까지 검토 중(PENDING)으로 남고, 각 응답의 협의 상태 · 제안 이력으로 확인한다.
# 푸시(FCM data-only)는 http/manual/push-check.http 로 기기를 등록한 뒤 실제 기기에서 확인한다.
#   data: type(PRICE_OFFER_RECEIVED | PRICE_OFFER_ACCEPTED | PRICE_OFFER_REJECTED), notificationId, applicationId, title, body, createdAt
#   (신청 알림이라 conversationId 는 넣지 않는다)
# 준비 단계에서 공개 공간을 만든다. (관리자 계정: http-client.private.env.json)

### 준비: 공간 제공자 가입
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "http-ntf-provider-{{$timestamp}}-{{$randomInt}}@test.dasisiheung.com",
  "password": "password123",
  "name": "역제안 제공자",
  "phone": "010-7777-8888",
  "role": "PROVIDER"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("ntfProviderEmail", response.body.data.email);
%}

### 준비: 공간 제공자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{ntfProviderEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
    client.global.set("ntfProviderToken", response.body.data.accessToken);
    const day = (offset) => new Date(Date.now() + 9 * 3600 * 1000 + offset * 86400 * 1000).toISOString().substring(0, 10);
    for (let i = 1; i <= 6; i++) {
        client.global.set(`ntfDay${i}`, day(i));
    }
%}

### 준비: 공간 등록 (정왕, 1일 5만원, 내일부터 5일, 최대 6명)
POST {{baseUrl}}/api/v1/provider/spaces
Authorization: Bearer {{ntfProviderToken}}
Content-Type: application/json

{
  "title": "정왕 시장 골목 2층",
  "description": "전통시장 입구 바로 앞 상가입니다.",
  "address": "경기도 시흥시 정왕대로 233",
  "latitude": 37.3517,
  "longitude": 126.7428,
  "areaSqm": 28.5,
  "buildingUse": "NEIGHBORHOOD_1",
  "commercialTheme": "FOOD_ALLEY",
  "dailyPrice": 50000,
  "facilities": ["ELECTRICITY", "WATER"],
  "activityTypes": ["POPUP_STORE", "EXPERIENCE"],
  "availableDates": ["{{ntfDay1}}", "{{ntfDay2}}", "{{ntfDay3}}", "{{ntfDay4}}", "{{ntfDay5}}"],
  "maxCapacity": 6
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("ntfSpaceId", response.body.data.id);
%}

### 준비: 증빙 제출
POST {{baseUrl}}/api/v1/provider/spaces/{{ntfSpaceId}}/proofs
Authorization: Bearer {{ntfProviderToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="proofType"

LEASE_CONTRACT
--dasi-boundary
Content-Disposition: form-data; name="file"; filename="proof.pdf"
Content-Type: application/pdf

< ./fixtures/proof.pdf
--dasi-boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
%}

### 준비: 관리자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("200 OK + ADMIN", () => {
        client.assert(response.status === 200, `실제 ${response.status} — http-client.private.env.json 의 관리자 계정 확인`);
        client.assert(response.body.data.member.role === "ADMIN", `실제 ${response.body.data.member.role}`);
    });
    client.global.set("adminToken", response.body.data.accessToken);
%}

