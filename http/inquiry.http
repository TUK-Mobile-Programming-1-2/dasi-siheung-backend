# 기대값: 400 INVALID_INPUT
POST {{baseUrl}}/api/v1/admin/inquiries/{{inqId}}/answer
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "answer": " "
}

> {%
    client.test("400 INVALID_INPUT", () => client.assert(response.status === 400, `실제 ${response.status}`));
