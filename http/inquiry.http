POST {{baseUrl}}/api/v1/inquiries/{{inqId}}/photos
Authorization: Bearer {{inqUserToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="files"; filename="not-an-image.jpg"
Content-Type: image/jpeg

< ./fixtures/not-an-image.jpg
--dasi-boundary--

> {%
    client.test("400 UNSUPPORTED_FILE_TYPE", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.code === "UNSUPPORTED_FILE_TYPE", `실제 ${response.body.error.code}`);
    });
%}

### 남의 문의에 사진 올리기
# 기대값: 403 NOT_INQUIRY_OWNER
POST {{baseUrl}}/api/v1/inquiries/{{inqId}}/photos
Authorization: Bearer {{inqProviderToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="files"; filename="space-photo.jpg"
Content-Type: image/jpeg

< ./fixtures/space-photo.jpg
--dasi-boundary--

> {%
    client.test("403 NOT_INQUIRY_OWNER", () => {
        client.assert(response.status === 403, `실제 ${response.status}`);
        client.assert(response.body.error.code === "NOT_INQUIRY_OWNER", `실제 ${response.body.error.code}`);
    });
%}

### 내 문의 내역
# 기대값: 200 OK, 1건 WAITING, 사진은 photoCount 만 (photos null)
GET {{baseUrl}}/api/v1/members/me/inquiries
Authorization: Bearer {{inqUserToken}}

> {%
    client.test("200 OK + 1건 답변 대기", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        const items = response.body.data.content;
        client.assert(items.length === 1, `실제 ${items.length}건`);
        client.assert(items[0].status === "WAITING", `실제 ${items[0].status}`);
        client.assert(items[0].photoCount === 2 && items[0].photos === null, "목록에는 photoCount 만");
    });
%}

