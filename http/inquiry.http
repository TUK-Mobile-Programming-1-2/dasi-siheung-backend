# 기대값: pendingInquiryCount >= 1
GET {{baseUrl}}/api/v1/admin/dashboard
Authorization: Bearer {{adminToken}}

> {%
    client.test("pendingInquiryCount", () => {
        client.assert(response.body.data.pendingInquiryCount >= 1, `실제 ${response.body.data.pendingInquiryCount}`);
    });
%}

