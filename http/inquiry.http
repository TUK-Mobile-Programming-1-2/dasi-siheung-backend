### 이용자가 관리자 문의 목록 호출
# 기대값: 403 FORBIDDEN
GET {{baseUrl}}/api/v1/admin/inquiries
Authorization: Bearer {{inqUserToken}}

> {%
    client.test("403 FORBIDDEN", () => client.assert(response.status === 403, `실제 ${response.status}`));
