### 준비: 관리자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("200 OK + ADMIN", () => {
        client.assert(response.status === 200, `실제 ${response.status} — http-client.private.env.json 의 관리자 계정 확인`);
        client.assert(response.body.data.member.role === "ADMIN", `실제 ${response.body.data.member.role}`);
    });
    client.global.set("adminToken", response.body.data.accessToken);
%}

### 관리자: 답변 대기 문의 목록
# 기대값: 200 OK, WAITING 만 (오래된 순), 사진은 photoCount 만, 방금 등록한 문의 포함
GET {{baseUrl}}/api/v1/admin/inquiries?status=WAITING&size=100
Authorization: Bearer {{adminToken}}

> {%
    client.test("200 OK + WAITING 만 + 사진은 장수만", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        const items = response.body.data.content;
        client.assert(items.every(i => i.status === "WAITING"), "WAITING 만");
        client.assert(items.every(i => i.photos === null), "목록에는 photos null");
        const mine = items.find(i => i.id === client.global.get("inqId"));
        client.assert(mine !== undefined, "방금 등록한 문의가 보여야 합니다");
        client.assert(mine.memberRole === "USER" && mine.photoCount === 2, JSON.stringify(mine));
    });
%}

