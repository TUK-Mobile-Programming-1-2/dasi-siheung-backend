# 1:1 문의 — 등록 → 사진 올리기(최대 3장) → 내 문의 내역 · 상세 → 관리자 답변 → 답변 확인
# 관리자 계정: http-client.private.env.json
# 사진은 문의를 등록한 뒤 POST /api/v1/inquiries/{inquiryId}/photos 로 따로 올린다. (파트 이름 files)

### 준비: 이용자 가입
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "http-inq-user-{{$timestamp}}-{{$randomInt}}@test.dasisiheung.com",
  "password": "password123",
  "name": "inq 이용자",
  "phone": "010-3000-0001",
  "role": "USER"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("inqUserEmail", response.body.data.email);
%}

### 준비: 이용자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{inqUserEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
    client.global.set("inqUserToken", response.body.data.accessToken);
%}

### 준비: 공간 제공자 가입 (남의 문의 확인용)
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "http-inq-provider-{{$timestamp}}-{{$randomInt}}@test.dasisiheung.com",
  "password": "password123",
  "name": "inq 제공자",
  "phone": "010-3000-0002",
  "role": "PROVIDER"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `실제 ${response.status}`));
    client.global.set("inqProviderEmail", response.body.data.email);
%}

### 준비: 공간 제공자 로그인
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{inqProviderEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
    client.global.set("inqProviderToken", response.body.data.accessToken);
%}


### 선택지: 문의 분류 · 상태
# 기대값: inquiryCategories 5개 (신청 · 예약 / 결제 · 환불 / 계정 / 공간 정보 / 기타), inquiryStatuses 2개
GET {{baseUrl}}/api/v1/options

> {%
    client.test("문의 선택지", () => {
        const codes = response.body.data.inquiryCategories.map(o => o.code).join(",");
        client.assert(codes === "APPLICATION,PAYMENT,ACCOUNT,SPACE,ETC", `실제 ${codes}`);
        const statuses = response.body.data.inquiryStatuses.map(o => o.code).join(",");
        client.assert(statuses === "WAITING,ANSWERED", `실제 ${statuses}`);
    });
%}

### 문의 등록
# 인증: 로그인 회원 (이용자 · 공간 제공자)
# 요청: JSON — category(선택지 inquiryCategories) · content(최대 1000자)
# 기대값: 201 Created, WAITING, answer · answeredAt null, photos 빈 배열
POST {{baseUrl}}/api/v1/inquiries
Authorization: Bearer {{inqUserToken}}
Content-Type: application/json

{
  "category": "ACCOUNT",
  "content": "비밀번호를 바꿨는데 로그인이 안 돼요."
}

> {%
    client.test("201 Created + WAITING", () => {
        client.assert(response.status === 201, `실제 ${response.status}`);
        const d = response.body.data;
        client.assert(d.status === "WAITING", `실제 ${d.status}`);
        client.assert(d.category === "ACCOUNT", `실제 ${d.category}`);
        client.assert(d.answer === null && d.answeredAt === null, "답변 전에는 null");
        client.assert(d.photoCount === 0 && d.photos.length === 0, "사진 없음");
    });
    client.global.set("inqId", response.body.data.id);
%}

### 문의 등록: 1001자
# 기대값: 400 INVALID_INPUT, fieldErrors[0].field = content
POST {{baseUrl}}/api/v1/inquiries
Authorization: Bearer {{inqUserToken}}
Content-Type: application/json

{
  "category": "ACCOUNT",
  "content": "{{$random.alphabetic(1001)}}"
}

> {%
    client.test("400 INVALID_INPUT (content)", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_INPUT", `실제 ${response.body.error.code}`);
        client.assert(response.body.error.fieldErrors[0].field === "content", JSON.stringify(response.body.error.fieldErrors));
    });
%}

### 문의 등록: 빈 내용 · 분류 없음
# 기대값: 400 INVALID_INPUT, 필드 오류 2개
POST {{baseUrl}}/api/v1/inquiries
Authorization: Bearer {{inqUserToken}}
Content-Type: application/json

{
  "content": "   "
}

> {%
    client.test("400 INVALID_INPUT (category · content)", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.fieldErrors.length === 2, JSON.stringify(response.body.error.fieldErrors));
    });
%}

### 문의 사진 올리기 — 2장
# 요청: multipart/form-data — files (같은 이름으로 여러 개, 문의당 최대 3장, JPG·PNG·WEBP 10MB)
# 기대값: 201 Created, 이 문의의 전체 사진 2장 · 임시 주소(10분)
POST {{baseUrl}}/api/v1/inquiries/{{inqId}}/photos
Authorization: Bearer {{inqUserToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="files"; filename="space-photo.jpg"
Content-Type: image/jpeg

< ./fixtures/space-photo.jpg
--dasi-boundary
Content-Disposition: form-data; name="files"; filename="space-photo.png"
Content-Type: image/png

< ./fixtures/space-photo.png
--dasi-boundary--

> {%
    client.test("201 Created + 사진 2장", () => {
        client.assert(response.status === 201, `실제 ${response.status}`);
        const d = response.body.data;
        client.assert(d.photoCount === 2 && d.photos.length === 2, JSON.stringify(d.photos));
        client.assert(d.photos.every(p => p.url.startsWith("http")), "전체 URL 임시 주소");
    });
%}

### 문의 사진 올리기 — 2장 더 (합쳐 4장)
# 기대값: 400 INQUIRY_PHOTO_LIMIT_EXCEEDED (파일을 올리기 전에 막힘)
POST {{baseUrl}}/api/v1/inquiries/{{inqId}}/photos
Authorization: Bearer {{inqUserToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="files"; filename="space-photo.jpg"
Content-Type: image/jpeg

< ./fixtures/space-photo.jpg
--dasi-boundary
Content-Disposition: form-data; name="files"; filename="space-photo.jpg"
Content-Type: image/jpeg

< ./fixtures/space-photo.jpg
--dasi-boundary--

> {%
    client.test("400 INQUIRY_PHOTO_LIMIT_EXCEEDED", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.code === "INQUIRY_PHOTO_LIMIT_EXCEEDED", `실제 ${response.body.error.code}`);
    });
%}

### 문의 사진 올리기 — 이미지가 아닌 파일
