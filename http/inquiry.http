### 관리자: 답변 등록
# 기대값: 200 OK, ANSWERED, answer · answeredAt 채워짐 (문의한 회원에게 INQUIRY_ANSWERED 푸시)
POST {{baseUrl}}/api/v1/admin/inquiries/{{inqId}}/answer
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "answer": "확인해 보니 예전 비밀번호로 저장된 자동 로그인 정보 때문이었어요. 앱을 다시 실행해 주세요."
}

> {%
    client.test("200 OK + ANSWERED", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        const d = response.body.data;
        client.assert(d.status === "ANSWERED", `실제 ${d.status}`);
        client.assert(d.answer.length > 0 && d.answeredAt !== null, "답변 · 답변 시각");
    });
%}

### 관리자: 다시 답변
# 기대값: 409 INQUIRY_ALREADY_ANSWERED
POST {{baseUrl}}/api/v1/admin/inquiries/{{inqId}}/answer
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "answer": "두 번째 답변"
}

> {%
    client.test("409 INQUIRY_ALREADY_ANSWERED", () => {
        client.assert(response.status === 409, `실제 ${response.status}`);
        client.assert(response.body.error.code === "INQUIRY_ALREADY_ANSWERED", `실제 ${response.body.error.code}`);
    });
%}


### 이용자: 답변 확인 (상세)
# 기대값: 200 OK, ANSWERED, 답변 · 답변 시각
GET {{baseUrl}}/api/v1/inquiries/{{inqId}}
Authorization: Bearer {{inqUserToken}}

> {%
    client.test("ANSWERED + 답변", () => {
        const d = response.body.data;
        client.assert(d.status === "ANSWERED", `실제 ${d.status}`);
        client.assert(d.answer.startsWith("확인해 보니"), `실제 ${d.answer}`);
        client.assert(d.answeredAt !== null, "answeredAt");
    });
%}

### 이용자: 답변 확인 (내역)
# 기대값: 목록에도 ANSWERED · 답변
GET {{baseUrl}}/api/v1/members/me/inquiries
Authorization: Bearer {{inqUserToken}}

> {%
    client.test("목록 ANSWERED", () => {
        const item = response.body.data.content[0];
        client.assert(item.status === "ANSWERED" && item.answer !== null, JSON.stringify(item));
    });
%}

