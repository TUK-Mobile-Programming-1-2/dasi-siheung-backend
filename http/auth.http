### 테스트용 이메일 준비 (실행할 때마다 새 이메일)
# 기대값: 200 OK (ping) — 이 요청은 다음 요청들에서 쓸 변수만 만든다.
GET {{baseUrl}}/api/v1/system/ping

> {%
    const suffix = Date.now() + "-" + Math.floor(Math.random() * 100000);
    client.global.set("authUserEmail", "http-user-" + suffix + "@test.dasisiheung.com");
    client.test("200 OK", () => client.assert(response.status === 200, `실제 ${response.status}`));
%}

### 회원가입 (이용자)
# 인증: 불필요
# 기대값: 201 Created
# { "success": true, "data": { "id": 1, "email": "...", "name": "김시흥", "role": "USER" } }
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "{{authUserEmail}}",
  "password": "password123",
  "name": "김시흥",
  "phone": "010-1234-5678",
  "role": "USER"
}

> {%
    client.test("201 Created + 회원 정보", () => {
        client.assert(response.status === 201, `기대 201, 실제 ${response.status}`);
        client.assert(response.body.data.email === client.global.get("authUserEmail"), "이메일이 다릅니다");
        client.assert(response.body.data.role === "USER", `실제 ${response.body.data.role}`);
        client.assert(response.body.data.password === undefined, "비밀번호가 응답에 있으면 안 됩니다");
    });
%}

### 같은 이메일로 다시 가입 → 409
# 기대값: 409 Conflict, error.code = DUPLICATE_EMAIL
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "{{authUserEmail}}",
  "password": "password123",
  "name": "김시흥",
  "phone": "01012345678",
  "role": "PROVIDER"
}

> {%
    client.test("409 DUPLICATE_EMAIL", () => {
        client.assert(response.status === 409, `기대 409, 실제 ${response.status}`);
        client.assert(response.body.error.code === "DUPLICATE_EMAIL", `실제 ${response.body.error.code}`);
    });
%}

### 관리자로 가입 시도 → 400
# 기대값: 400 Bad Request, error.code = ROLE_NOT_ALLOWED
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "admin-{{$uuid}}@test.dasisiheung.com",
  "password": "password123",
  "name": "관리자",
  "phone": "01012345678",
  "role": "ADMIN"
}

> {%
    client.test("400 ROLE_NOT_ALLOWED", () => {
        client.assert(response.status === 400, `기대 400, 실제 ${response.status}`);
        client.assert(response.body.error.code === "ROLE_NOT_ALLOWED", `실제 ${response.body.error.code}`);
    });
%}

### 입력값 오류 → 400 + 필드별 사유
# 기대값: 400, error.code = INVALID_INPUT, error.fieldErrors 에 email·password 포함
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "short",
  "name": "김시흥",
  "phone": "010-1234-5678",
  "role": "USER"
}

> {%
    client.test("400 INVALID_INPUT + fieldErrors", () => {
        client.assert(response.status === 400, `기대 400, 실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_INPUT", `실제 ${response.body.error.code}`);
        const fields = response.body.error.fieldErrors.map(e => e.field);
        client.assert(fields.includes("email") && fields.includes("password"), `실제 ${fields}`);
    });
%}

### 로그인 (이메일 대소문자는 구분하지 않음)
# 기대값: 200 OK
# { "data": { "tokenType": "Bearer", "accessToken": "...", "accessTokenExpiresIn": 1800,
#             "refreshToken": "...", "refreshTokenExpiresIn": 1209600, "member": { ... } } }
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{authUserEmail}}",
  "password": "password123"
}

> {%
    client.test("200 OK + 토큰 발급", () => {
        client.assert(response.status === 200, `기대 200, 실제 ${response.status}`);
        client.assert(response.body.data.tokenType === "Bearer", `실제 ${response.body.data.tokenType}`);
        client.assert(response.body.data.accessTokenExpiresIn === 1800, `실제 ${response.body.data.accessTokenExpiresIn}`);
        client.assert(response.body.data.member.role === "USER", `실제 ${response.body.data.member.role}`);
    });
    client.global.set("authAccessToken", response.body.data.accessToken);
    client.global.set("authRefreshToken", response.body.data.refreshToken);
%}

### 비밀번호가 틀리면 → 401
# 기대값: 401, error.code = INVALID_CREDENTIALS
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{authUserEmail}}",
  "password": "wrong-password1"
}

> {%
    client.test("401 INVALID_CREDENTIALS", () => {
        client.assert(response.status === 401, `기대 401, 실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_CREDENTIALS", `실제 ${response.body.error.code}`);
    });
%}

### 위조된 토큰으로 보호된 API 호출 → 401 INVALID_TOKEN
# 기대값: 401, error.code = INVALID_TOKEN
GET {{baseUrl}}/api/v1/members/me
Authorization: Bearer forged.token.value

> {%
    client.test("401 INVALID_TOKEN", () => {
        client.assert(response.status === 401, `기대 401, 실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_TOKEN", `실제 ${response.body.error.code}`);
    });
%}

### 토큰 재발급
# 기대값: 200 OK, 새 refreshToken 은 이전 값과 다름
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{authRefreshToken}}"
}

> {%
    // client.test 콜백은 핸들러 본문이 끝난 뒤 실행되므로, 덮어쓰기 전에 이전 토큰을 잡아 둔다
    const usedRefreshToken = client.global.get("authRefreshToken");
    const newRefreshToken = response.body.data.refreshToken;
    client.test("200 OK + 새 리프레시 토큰", () => {
        client.assert(response.status === 200, `기대 200, 실제 ${response.status}`);
        client.assert(newRefreshToken !== usedRefreshToken, "토큰이 교체되지 않았습니다");
    });
    client.global.set("authUsedRefreshToken", usedRefreshToken);
    client.global.set("authRefreshToken", newRefreshToken);
    client.global.set("authAccessToken", response.body.data.accessToken);
%}

### 이미 사용한 리프레시 토큰 재사용 → 401
# 기대값: 401, error.code = INVALID_REFRESH_TOKEN
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{authUsedRefreshToken}}"
}

> {%
    client.test("401 INVALID_REFRESH_TOKEN", () => {
        client.assert(response.status === 401, `기대 401, 실제 ${response.status}`);
        client.assert(response.body.error.code === "INVALID_REFRESH_TOKEN", `실제 ${response.body.error.code}`);
    });
%}

### 로그아웃
# 기대값: 200 OK, { "success": true }
POST {{baseUrl}}/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{authRefreshToken}}"
}

> {%
    client.test("200 OK", () => {
        client.assert(response.status === 200, `기대 200, 실제 ${response.status}`);
        client.assert(response.body.success === true, "success 가 true 여야 합니다");
    });
%}

### 로그아웃한 리프레시 토큰으로 재발급 → 401
# 기대값: 401, error.code = INVALID_REFRESH_TOKEN
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{authRefreshToken}}"
}

> {%
    client.test("401 INVALID_REFRESH_TOKEN", () => {
        client.assert(response.status === 401, `기대 401, 실제 ${response.status}`);
    });
%}
