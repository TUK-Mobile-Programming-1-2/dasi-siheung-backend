POST {{baseUrl}}/api/v1/admin/reports/{{rptReportId}}/resolve
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "action": "DISMISS"
}

> {%
    client.test("409 REPORT_ALREADY_RESOLVED", () => client.assert(response.body.error.code === "REPORT_ALREADY_RESOLVED", `실제 ${response.body.error.code}`));
%}

