> {%
    client.test("400 REPORT_PHOTO_LIMIT_EXCEEDED", () => {
        client.assert(response.status === 400, `실제 ${response.status}`);
        client.assert(response.body.error.code === "REPORT_PHOTO_LIMIT_EXCEEDED", `실제 ${response.body.error.code}`);
    });
%}

### 예전 JSON 요청
# 기대값: 415 UNSUPPORTED_MEDIA_TYPE (multipart 로만 받음)
POST {{baseUrl}}/api/v1/reports
Authorization: Bearer {{rptUserToken}}
Content-Type: application/json

{
  "targetType": "SPACE",
  "targetId": {{rptSpaceId}},
  "reason": "SPAM"
}

> {%
    client.test("415 UNSUPPORTED_MEDIA_TYPE", () => {
        client.assert(response.status === 415, `실제 ${response.status}`);
        client.assert(response.body.error.code === "UNSUPPORTED_MEDIA_TYPE", `실제 ${response.body.error.code}`);
    });
%}

### 내 신고 내역
# 인증: 로그인 회원
# 기대값: 200 OK, 방금 한 신고 1건 (PENDING, 사진 2장, 대상 요약 = 공간 이름), 관리자 메모 · 사진 주소 없음
GET {{baseUrl}}/api/v1/members/me/reports
Authorization: Bearer {{rptUserToken}}

> {%
    client.test("200 OK + 1건 PENDING", () => {
        const items = response.body.data.content;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.totalElements === 1, `실제 ${response.body.data.totalElements}`);
        client.assert(items[0].id === client.global.get("rptReportId"), JSON.stringify(items[0]));
        client.assert(items[0].status === "PENDING" && items[0].photoCount === 2, JSON.stringify(items[0]));
        client.assert(items[0].targetSummary === "신고 시나리오 공간" && items[0].resolvedAt === null, JSON.stringify(items[0]));
        client.assert(items[0].adminNote === undefined && items[0].photos === undefined, "관리자 메모 · 사진은 주지 않아야 합니다");
    });
%}

### 관리자: 처리 대기 신고 목록
# 인증: ADMIN
# 기대값: 200 OK, 모두 PENDING
GET {{baseUrl}}/api/v1/admin/reports?status=PENDING&size=100
Authorization: Bearer {{adminToken}}

> {%
    client.test("200 OK + PENDING 만 + 사진은 장수만", () => {
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.content.every(r => r.status === "PENDING"), "처리된 신고가 섞였습니다");
        client.assert(response.body.data.content.every(r => typeof r.photoCount === "number" && r.photos === null),
            "목록에는 photoCount 만, photos 는 null");
    });
%}

### 관리자: 신고 상세 — 증거 사진
# 기대값: 200 OK, photoCount 2, 사진 2장 임시 주소 (10분 뒤 만료)
GET {{baseUrl}}/api/v1/admin/reports/{{rptReportId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("사진 2장 + 임시 주소", () => {
        const d = response.body.data;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(d.photoCount === 2 && d.photos.length === 2, JSON.stringify(d.photos));
        client.assert(d.photos.every(p => p.url.length > 0), "임시 주소");
    });
%}

### 관리자: 정지 일수 없이 정지 처리
# 기대값: 400 INVALID_INPUT
POST {{baseUrl}}/api/v1/admin/reports/{{rptReportId}}/resolve
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "action": "SUSPEND"
}

> {%
    client.test("400 INVALID_INPUT", () => client.assert(response.status === 400, `실제 ${response.status}`));
%}

### 관리자: 숨김 + 이용 정지 7일
# 기대값: 200 OK, RESOLVED, 대상 숨김, 제공자 SUSPENDED
POST {{baseUrl}}/api/v1/admin/reports/{{rptReportId}}/resolve
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "action": "HIDE_AND_SUSPEND",
  "suspendDays": 7,
  "note": "허위 사진 확인, 1주 정지"
}

> {%
    client.test("RESOLVED + 숨김 + 정지", () => {
        const d = response.body.data;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(d.status === "RESOLVED" && d.targetVisible === false && d.ownerStatus === "SUSPENDED", JSON.stringify(d));
    });
%}

### 내 신고 내역 — 처리 완료만
# 기대값: 200 OK, RESOLVED 1건, 처리 시각 있음
GET {{baseUrl}}/api/v1/members/me/reports?status=RESOLVED
Authorization: Bearer {{rptUserToken}}

> {%
    client.test("200 OK + RESOLVED 1건", () => {
        const items = response.body.data.content;
        client.assert(response.status === 200, `실제 ${response.status}`);
        client.assert(response.body.data.totalElements === 1, `실제 ${response.body.data.totalElements}`);
        client.assert(items[0].status === "RESOLVED" && items[0].resolvedAt !== null, JSON.stringify(items[0]));
    });
%}

### 숨긴 공간은 이용자에게 보이지 않는다
# 기대값: 404 SPACE_NOT_FOUND
GET {{baseUrl}}/api/v1/spaces/{{rptSpaceId}}

> {%
    client.test("404", () => client.assert(response.status === 404, `실제 ${response.status}`));
%}

