### 신고하기 (공간) — 증거 사진 2장
# 인증: 로그인 회원
# 요청: multipart/form-data — targetType · targetId · reason · detail(선택) 텍스트 + photos(선택, 최대 5장)
# 기대값: 201 Created, PENDING, 사진 2장 · 임시 주소
POST {{baseUrl}}/api/v1/reports
Authorization: Bearer {{rptUserToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="targetType"

SPACE
--dasi-boundary
Content-Disposition: form-data; name="targetId"

{{rptSpaceId}}
--dasi-boundary
Content-Disposition: form-data; name="reason"

FALSE_INFORMATION
--dasi-boundary
Content-Disposition: form-data; name="detail"

사진과 실제 공간이 전혀 다릅니다.
--dasi-boundary
Content-Disposition: form-data; name="photos"; filename="space-photo.jpg"
Content-Type: image/jpeg

< ./fixtures/space-photo.jpg
--dasi-boundary
Content-Disposition: form-data; name="photos"; filename="space-photo.png"
Content-Type: image/png

< ./fixtures/space-photo.png
--dasi-boundary--

> {%
    client.test("201 Created + PENDING + 사진 2장", () => {
        client.assert(response.status === 201, `실제 ${response.status}`);
        client.assert(response.body.data.status === "PENDING", `실제 ${response.body.data.status}`);
        client.assert(response.body.data.photos.length === 2, `실제 ${response.body.data.photos.length}`);
        client.assert(response.body.data.photos.every(p => p.url.length > 0), "임시 주소");
    });
    client.global.set("rptReportId", response.body.data.id);
%}

### 같은 대상 다시 신고 (사진 없이)
# 기대값: 409 DUPLICATE_REPORT
POST {{baseUrl}}/api/v1/reports
Authorization: Bearer {{rptUserToken}}
Content-Type: multipart/form-data; boundary=dasi-boundary

--dasi-boundary
Content-Disposition: form-data; name="targetType"

SPACE
--dasi-boundary
Content-Disposition: form-data; name="targetId"

{{rptSpaceId}}
--dasi-boundary
Content-Disposition: form-data; name="reason"

SPAM
--dasi-boundary--

> {%
    client.test("409 DUPLICATE_REPORT", () => {
        client.assert(response.status === 409, `실제 ${response.status}`);
        client.assert(response.body.error.code === "DUPLICATE_REPORT", `실제 ${response.body.error.code}`);
    });
%}

